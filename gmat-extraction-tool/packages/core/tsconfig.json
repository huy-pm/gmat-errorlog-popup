{
    "compilerOptions": {
        "baseUrl": ".",
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "sourceMap": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ]
}